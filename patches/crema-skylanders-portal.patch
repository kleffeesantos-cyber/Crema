+// The in-game menu's Portal of Power page (after DolphinPS4's): the emulated Skylanders portal's 16
+// slots, each holding a figure from /data/Crema/Skylanders (.sky dumps of real figures, or new ones
+// made from the list of every figure). What is on the portal is remembered and put back the next
+// time a game starts.
+#pragma once
+
+struct ImDrawList;
+struct ImFont;
+
+namespace PS4PortalPage
+{
+struct Keys
+{
+	bool up, down, left, right, cross, circle, square;
+};
+
+// At game start: puts back the figures that were on the portal last time.
+void Restore();
+// Opens the page (L3 + R3 menu -> Portal of Power).
+void Open();
+// A frame's presses; false once Circle left the page.
+bool Input(const Keys& pressed);
+// The page, in the panel from x0 to W.
+void Draw(ImDrawList* dl, ImFont* title, ImFont* font, ImFont* small, float x0, float W, float H, float a, float dt);
+} // namespace PS4PortalPage
