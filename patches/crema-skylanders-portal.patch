@@ -0,0 +1,454 @@
+#include "gui/ps4/PS4PortalPage.h"
+
+#include "Cafe/OS/libs/nsyshid/Skylander.h"
+#include "gui/ps4/launcher/PS4Glyphs.h"
+
+#include <imgui.h>
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <fstream>
+#include <memory>
+#include <sstream>
+
+extern "C" void ps4_boot_trace(const char* line); // port/ps4_crashlog.cpp
+
+namespace PS4PortalPage
+{
+namespace
+{
+	constexpr const char* kDir = "/data/Crema/Skylanders";
+	constexpr const char* kState = "/data/Crema/Skylanders/portal.txt";
+	constexpr int kSlots = nsyshid::MAX_SKYLANDERS; // the portal holds 16 figures
+
+	// What is on the portal: one entry per slot of the page (the portal's own slot can differ).
+	struct Figure
+	{
+		bool on = false;
+		uint8 portalSlot = 0;
+		uint16 id = 0, var = 0;
+		std::string file; // name inside kDir
+	};
+	Figure sFigures[kSlots];
+
+	enum class Mode
+	{
+		Slots, // the 16 slots
+		Pick,  // one slot: remove, make a new figure, or a file from the folder
+		New,   // the list of every figure
+	};
+	enum Kind
+	{
+		KIND_REMOVE,
+		KIND_NEW,
+		KIND_FILE,
+		KIND_FIGURE,
+	};
+	struct Entry
+	{
+		Kind kind;
+		std::string label;
+		std::string file;     // KIND_FILE
+		uint16 id = 0, var = 0; // KIND_FIGURE
+	};
+
+	Mode sMode = Mode::Slots;
+	int sSlot = 0;     // the slot being changed
+	int sSelected = 0; // row of the current list
+	float sScroll = 0.0f;
+	std::vector<Entry> sEntries; // Pick and New
+	std::string sMessage;
+	double sMessageUntil = 0.0;
+
+	double Now()
+	{
+		return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+	}
+
+	ImU32 Rgba(uint32 rgb, float alpha)
+	{
+		return IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, (int)(std::clamp(alpha, 0.0f, 1.0f) * 255.0f));
+	}
+
+	void Say(const std::string& text, double seconds = 5.0)
+	{
+		sMessage = text;
+		sMessageUntil = Now() + seconds;
+	}
+
+	std::string Lower(std::string text)
+	{
+		for (char& c : text)
+			c = (char)std::tolower((unsigned char)c);
+		return text;
+	}
+
+	void EnsureFolder()
+	{
+		std::error_code ec;
+		fs::create_directories(kDir, ec);
+	}
+
+	// a name that is safe as a file name: letters, digits, space, - _ ( ) '
+	std::string SafeName(const std::string& name)
+	{
+		std::string out;
+		for (const char c : name)
+			out += (std::isalnum((unsigned char)c) || c == ' ' || c == '-' || c == '_' || c == '(' || c == ')' || c == '\'') ? c : '_';
+		return out.empty() ? std::string("Figure") : out;
+	}
+
+	bool IsFigureFile(const fs::path& path)
+	{
+		const std::string ext = Lower(path.extension().string());
+		return ext == ".sky" || ext == ".bin" || ext == ".dump" || ext == ".dmp";
+	}
+
+	// which slot of the page holds this file (-1: none)
+	int SlotOfFile(const std::string& file)
+	{
+		for (int i = 0; i < kSlots; i++)
+			if (sFigures[i].on && sFigures[i].file == file)
+				return i;
+		return -1;
+	}
+
+	// what is on the portal, written after every change
+	void Store()
+	{
+		EnsureFolder();
+		std::ofstream out(kState, std::ios::trunc);
+		for (int i = 0; i < kSlots; i++)
+			if (sFigures[i].on)
+				out << i << "=" << sFigures[i].file << "\n";
+	}
+
+	std::string NameOf(const Figure& figure)
+	{
+		return nsyshid::g_skyportal.FindSkylander(figure.id, figure.var);
+	}
+
+	void Clear(int slot, bool store = true)
+	{
+		Figure& figure = sFigures[slot];
+		if (!figure.on)
+			return;
+		nsyshid::g_skyportal.RemoveSkylander(figure.portalSlot); // saves the figure's file
+		figure = Figure();
+		if (store)
+			Store();
+	}
+
+	// Puts the dump on the portal in this slot; "" or the reason it didn't.
+	std::string LoadFile(int slot, const std::string& file, bool store = true)
+	{
+		// the folder only: no path in the name
+		if (file.empty() || file.find('/') != std::string::npos || file.find("..") != std::string::npos)
+			return "Not a file of " + std::string(kDir);
+		const int other = SlotOfFile(file);
+		if (other >= 0 && other != slot)
+			return fmt::format("{} is already on the portal (slot {})", file, other + 1);
+		std::unique_ptr<FileStream> stream(FileStream::openFile2(fs::path(kDir) / file, true));
+		if (!stream)
+			return "Can't open " + file;
+		std::array<uint8, nsyshid::SKY_FIGURE_SIZE> data;
+		if (stream->readData(data.data(), (uint32)data.size()) != data.size())
+			return file + " is too small to be a Skylander";
+		Clear(slot, false);
+		Figure figure;
+		figure.id = uint16(data[0x11]) << 8 | uint16(data[0x10]);
+		figure.var = uint16(data[0x1D]) << 8 | uint16(data[0x1C]);
+		figure.portalSlot = nsyshid::g_skyportal.LoadSkylander(data.data(), std::move(stream));
+		if (figure.portalSlot == 0xFF)
+			return "The portal is full";
+		figure.on = true;
+		figure.file = file;
+		sFigures[slot] = figure;
+		if (store)
+			Store();
+		return {};
+	}
+
+	// A new figure from the list: a fresh dump in the folder, put on the portal.
+	std::string MakeFigure(int slot, uint16 id, uint16 var)
+	{
+		EnsureFolder();
+		const std::string base = SafeName(nsyshid::g_skyportal.FindSkylander(id, var));
+		std::string file = base + ".sky";
+		std::error_code ec;
+		for (int n = 2; fs::exists(fs::path(kDir) / file, ec); n++)
+			file = fmt::format("{} ({}).sky", base, n);
+		if (!nsyshid::g_skyportal.CreateSkylander(fs::path(kDir) / file, id, var))
+			return "Can't create " + file;
+		return LoadFile(slot, file);
+	}
+
+	void FillPick()
+	{
+		sEntries.clear();
+		if (sFigures[sSlot].on)
+			sEntries.push_back({KIND_REMOVE, "Remove from the Portal", {}});
+		sEntries.push_back({KIND_NEW, "Make a New Figure", {}});
+		EnsureFolder();
+		std::vector<std::string> files;
+		std::error_code ec;
+		for (const auto& item : fs::directory_iterator(kDir, ec))
+			if (item.is_regular_file(ec) && IsFigureFile(item.path()))
+				files.push_back(item.path().filename().string());
+		std::sort(files.begin(), files.end(), [](const std::string& a, const std::string& b) { return Lower(a) < Lower(b); });
+		for (const std::string& file : files)
+			sEntries.push_back({KIND_FILE, file, file});
+		sSelected = sFigures[sSlot].on ? 1 : 0; // on "Make a New Figure" or the first row
+		sScroll = 0.0f;
+	}
+
+	void FillNew()
+	{
+		sEntries.clear();
+		for (const auto& item : nsyshid::SkylanderUSB::GetListSkylanders())
+		{
+			Entry entry{KIND_FIGURE, item.second, {}};
+			entry.id = item.first.first;
+			entry.var = item.first.second;
+			sEntries.push_back(std::move(entry));
+		}
+		std::stable_sort(sEntries.begin(), sEntries.end(), [](const Entry& a, const Entry& b) { return Lower(a.label) < Lower(b.label); });
+		sSelected = 0;
+		sScroll = 0.0f;
+	}
+
+	int RowCount()
+	{
+		return sMode == Mode::Slots ? kSlots : (int)sEntries.size();
+	}
+
+	void GoSlots()
+	{
+		sMode = Mode::Slots;
+		sSelected = sSlot;
+		sScroll = 0.0f;
+	}
+} // namespace
+
+void Restore()
+{
+	EnsureFolder();
+	std::ifstream in(kState);
+	std::string line;
+	int restored = 0;
+	while (std::getline(in, line))
+	{
+		const size_t eq = line.find('=');
+		if (eq == std::string::npos)
+			continue;
+		const int slot = atoi(line.substr(0, eq).c_str());
+		if (slot < 0 || slot >= kSlots)
+			continue;
+		const std::string problem = LoadFile(slot, line.substr(eq + 1), false);
+		if (problem.empty())
+			restored++;
+		else
+			ps4_boot_trace(("portal: " + problem).c_str());
+	}
+	if (restored)
+		Store(); // a figure that has gone is forgotten
+	ps4_boot_trace(fmt::format("portal: {} figure(s) put back on the portal", restored).c_str());
+}
+
+void Open()
+{
+	sMode = Mode::Slots;
+	sSelected = 0;
+	sSlot = 0;
+	sScroll = 0.0f;
+	sMessage.clear();
+}
+
+bool Input(const Keys& pressed)
+{
+	if (sMode == Mode::Slots)
+	{
+		if (pressed.up)
+			sSelected = (sSelected + kSlots - 1) % kSlots;
+		if (pressed.down)
+			sSelected = (sSelected + 1) % kSlots;
+		if (pressed.circle)
+			return false;
+		if (pressed.cross)
+		{
+			sSlot = sSelected;
+			sMode = Mode::Pick;
+			FillPick();
+		}
+		else if (pressed.square && sFigures[sSelected].on)
+		{
+			Say("Removed: " + NameOf(sFigures[sSelected]));
+			Clear(sSelected);
+		}
+		return true;
+	}
+
+	const int count = RowCount();
+	if (count > 0)
+	{
+		if (pressed.up)
+			sSelected = (sSelected + count - 1) % count;
+		if (pressed.down)
+			sSelected = (sSelected + 1) % count;
+		if (sMode == Mode::New)
+		{
+			// the list of every figure is long: Left / Right jump ten at a time
+			if (pressed.left)
+				sSelected = std::max(0, sSelected - 10);
+			if (pressed.right)
+				sSelected = std::min(count - 1, sSelected + 10);
+		}
+		sSelected = std::clamp(sSelected, 0, count - 1);
+	}
+	if (pressed.circle)
+	{
+		if (sMode == Mode::New)
+		{
+			sMode = Mode::Pick;
+			FillPick();
+		}
+		else
+			GoSlots();
+		return true;
+	}
+	if (!pressed.cross || count == 0)
+		return true;
+
+	const Entry entry = sEntries[sSelected];
+	switch (entry.kind)
+	{
+	case KIND_REMOVE:
+		Say("Removed: " + NameOf(sFigures[sSlot]));
+		Clear(sSlot);
+		GoSlots();
+		break;
+	case KIND_NEW:
+		sMode = Mode::New;
+		FillNew();
+		break;
+	case KIND_FILE:
+	case KIND_FIGURE:
+	{
+		const std::string problem = entry.kind == KIND_FILE ? LoadFile(sSlot, entry.file) : MakeFigure(sSlot, entry.id, entry.var);
+		if (problem.empty())
+			Say("On the portal: " + NameOf(sFigures[sSlot]));
+		else
+			Say(problem);
+		GoSlots();
+		break;
+	}
+	}
+	return true;
+}
+
+void Draw(ImDrawList* dl, ImFont* title, ImFont* font, ImFont* small, float x0, float W, float H, float a, float dt)
+{
+	constexpr uint32 ACCENT = 0x9B7BFF, TEXT = 0xFFFFFF, ON = 0x7CE38B;
+	int onPortal = 0;
+	for (const Figure& figure : sFigures)
+		onPortal += figure.on;
+
+	std::string heading = "Portal of Power", subtitle;
+	if (sMode == Mode::Slots)
+		subtitle = fmt::format("{} of {} figures on the portal", onPortal, kSlots);
+	else if (sMode == Mode::Pick)
+		subtitle = fmt::format("Slot {}", sSlot + 1);
+	else
+		subtitle = fmt::format("Slot {}: every figure, {} in all", sSlot + 1, sEntries.size());
+	dl->AddText(title, 44.0f, ImVec2(x0 + 50, 90), Rgba(TEXT, a), heading.c_str());
+	dl->AddText(small, 24.0f, ImVec2(x0 + 52, 148), Rgba(ACCENT, a), subtitle.c_str());
+
+	constexpr float ROW_H = 54.0f, TOP = 210.0f;
+	const float bottom = H - 170.0f;
+	const int count = RowCount();
+	sSelected = std::clamp(sSelected, 0, std::max(0, count - 1));
+	const float selY = sSelected * ROW_H;
+	float target = sScroll;
+	if (selY - target < ROW_H)
+		target = std::max(0.0f, selY - ROW_H);
+	if (selY - target > bottom - TOP - 2 * ROW_H)
+		target = selY - (bottom - TOP - 2 * ROW_H);
+	sScroll += (target - sScroll) * (1.0f - std::exp(-18.0f * dt));
+	dl->PushClipRect(ImVec2(x0, TOP - 10), ImVec2(W, bottom), true);
+	for (int i = 0; i < count; i++)
+	{
+		const float y = TOP + i * ROW_H - sScroll;
+		if (y < TOP - ROW_H - 20.0f || y > bottom + 10.0f)
+			continue;
+		const bool sel = i == sSelected;
+		if (sel)
+			dl->AddRectFilled(ImVec2(x0 + 30, y - 4), ImVec2(W - 30, y + 46), Rgba(ACCENT, 0.30f * a), 10.0f);
+		std::string label, value;
+		uint32 colour = TEXT;
+		if (sMode == Mode::Slots)
+		{
+			label = fmt::format("Slot {}", i + 1);
+			const Figure& figure = sFigures[i];
+			value = figure.on ? NameOf(figure) : "Empty";
+			colour = figure.on ? ON : TEXT;
+		}
+		else
+		{
+			const Entry& entry = sEntries[i];
+			label = entry.label;
+			if (entry.kind == KIND_FILE)
+			{
+				const int other = SlotOfFile(entry.file);
+				if (other >= 0)
+					value = fmt::format("Slot {}", other + 1), colour = ON;
+			}
+		}
+		const float vw = font->CalcTextSizeA(26.0f, FLT_MAX, 0.0f, value.c_str()).x;
+		while (!label.empty() && font->CalcTextSizeA(30.0f, FLT_MAX, 0.0f, label.c_str()).x > W - x0 - 160.0f - vw)
+			label.pop_back();
+		dl->AddText(font, 30.0f, ImVec2(x0 + 60, y + 4), Rgba(TEXT, a * (sel ? 1.0f : 0.85f)), label.c_str());
+		dl->AddText(font, 26.0f, ImVec2(W - 70 - vw, y + 8), Rgba(colour, 0.85f * a), value.c_str());
+	}
+	dl->PopClipRect();
+
+	std::string help;
+	if (Now() < sMessageUntil)
+		help = sMessage;
+	else if (sMode == Mode::Slots)
+		help = "Cross: choose a figure for the slot.  Square: take it off.  What is on the portal comes back next time.";
+	else if (sMode == Mode::Pick)
+		help = sEntries.size() <= 2 ? "Put .sky dumps of your figures in /data/Crema/Skylanders and they show up here." :
+									  "Dumps in /data/Crema/Skylanders.  Make a New Figure starts one from the list.";
+	else
+		help = "Left / Right: ten at a time.  Cross makes the figure, saved in /data/Crema/Skylanders.";
+	// wrap the help over two lines
+	const float maxW = W - x0 - 100.0f;
+	std::string line1 = help, line2;
+	if (small->CalcTextSizeA(24.0f, FLT_MAX, 0.0f, help.c_str()).x > maxW)
+	{
+		size_t cut = help.size();
+		while (cut > 0 && (help[cut - 1] != ' ' || small->CalcTextSizeA(24.0f, FLT_MAX, 0.0f, help.substr(0, cut).c_str()).x > maxW))
+			cut--;
+		if (cut > 0)
+		{
+			line1 = help.substr(0, cut);
+			line2 = help.substr(cut);
+		}
+	}
+	dl->AddText(small, 24.0f, ImVec2(x0 + 50, H - 140), Rgba(TEXT, 0.75f * a), line1.c_str());
+	if (!line2.empty())
+		dl->AddText(small, 24.0f, ImVec2(x0 + 50, H - 110), Rgba(TEXT, 0.75f * a), line2.c_str());
+	float bx = x0 + 50;
+	const float by = H - 60.0f;
+	auto hint = [&](const char* glyph, const char* text) {
+		bx += PS4Glyphs::Draw(dl, small, glyph, bx, by, 34.0f, a) + 10.0f;
+		dl->AddText(small, 24.0f, ImVec2(bx, by - 13), Rgba(TEXT, 0.85f * a), text);
+		bx += small->CalcTextSizeA(24.0f, FLT_MAX, 0.0f, text).x + 36.0f;
+	};
+	hint("Cross", sMode == Mode::Slots ? "Choose" : "Select");
+	if (sMode == Mode::Slots && sFigures[std::clamp(sSelected, 0, kSlots - 1)].on)
+		hint("Square", "Take off");
+	hint("Circle", "Back");
+}
+} // namespace PS4PortalPage
